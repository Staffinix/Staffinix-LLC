# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-side caller-scoped Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Comma-separated authorization policy. If work domains are configured, only
# those domains and exact email exceptions can use protected application APIs.
AUTH_ALLOWED_WORK_EMAIL_DOMAINS=company.example
AUTH_EMAIL_ALLOWLIST=

# Optional hosted AI gateway. Leave empty to use the local/RAG fallback.
LOVABLE_API_KEY=

# L4 Smart Email integrations (server-only). Use one callback URI per provider,
# both ending at /settings/email-accounts/callback?provider=<provider>.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EMAIL_REDIRECT_URI=https://app.example.com/settings/email-accounts/callback?provider=gmail
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_EMAIL_REDIRECT_URI=https://app.example.com/settings/email-accounts/callback?provider=microsoft
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EMAIL_TOKEN_ENCRYPTION_KEY=

# Private document-processing worker
DOCUMENT_PROCESSOR_URL=https://document-worker.internal.example
DOCUMENT_PROCESSOR_TOKEN=replace_with_at_least_32_random_characters

# RAG services. Production endpoints must use HTTPS.
QDRANT_URL=https://qdrant.internal.example
QDRANT_API_KEY=
QDRANT_COLLECTION=staffinix_knowledge
OLLAMA_URL=https://ollama.internal.example
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=gemma3:4b

# Document worker process only
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
PORT=8788
